  "es": "\n    <h2>Editor de manos <button data-a=\"camara\" title=\"Volver a la cámara del clip\">Cámara del clip</button></h2>\n    <div class=\"fila\"><button data-mano=\"der\">Derecha</button><button data-mano=\"izq\">Izquierda</button><button data-a=\"quitarMano\">Quitar mano</button></div>\n    <div class=\"fila\"><button data-a=\"previo\" title=\"Cuadro anterior (←)\">◀</button><button data-a=\"agregar\" title=\"Agregar cuadro aquí (K)\">+ Cuadro aquí</button>\n      <button data-a=\"siguiente\" title=\"Cuadro siguiente (→)\">▶</button><button data-a=\"borrar\" title=\"Borrar cuadro (Supr)\">Borrar</button></div>\n    <div class=\"fila\" data-zona=\"cuadro\"><label>Tiempo <input type=\"number\" step=\"0.1\" min=\"0\" data-c=\"t\"></label>\n      <label>Sigue a <select data-c=\"sigue\"></select></label></div>\n    <div class=\"fila\" data-zona=\"cuadro\"><button data-modo=\"translate\" title=\"W\">Mover</button><button data-modo=\"rotate\" title=\"E\">Girar</button>\n      <label>Pose <select data-c=\"pose\"><option value=\"\">—</option>",
  "en": "\n    <h2>Hand editor <button data-a=\"camara\" title=\"Back to the clip camera\">Clip camera</button></h2>\n    <div class=\"fila\"><button data-mano=\"der\">Right</button><button data-mano=\"izq\">Left</button><button data-a=\"quitarMano\">Remove hand</button></div>\n    <div class=\"fila\"><button data-a=\"previo\" title=\"Previous keyframe (←)\">◀</button><button data-a=\"agregar\" title=\"Add keyframe here (K)\">+ Keyframe here</button>\n      <button data-a=\"siguiente\" title=\"Next keyframe (→)\">▶</button><button data-a=\"borrar\" title=\"Delete keyframe (Del)\">Delete</button></div>\n    <div class=\"fila\" data-zona=\"cuadro\"><label>Time <input type=\"number\" step=\"0.1\" min=\"0\" data-c=\"t\"></label>\n      <label>Follows <select data-c=\"sigue\"></select></label></div>\n    <div class=\"fila\" data-zona=\"cuadro\"><button data-modo=\"translate\" title=\"W\">Move</button><button data-modo=\"rotate\" title=\"E\">Rotate</button>\n      <label>Pose <select data-c=\"pose\"><option value=\"\">—</option>",
